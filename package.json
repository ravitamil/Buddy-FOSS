{
  "name": "buddy",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "expo start --ios",
    "lint": "eslint src app --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src app --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "lint:all": "pnpm type-check && pnpm lint",
    "format": "prettier --write src/**/*.{ts,tsx,js,jsx}",
    "format:check": "prettier --check src/**/*.{ts,tsx,js,jsx}",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:performance": "jest --selectProjects performance",
    "test:production": "jest --selectProjects production",
    "test:ci": "jest --coverage --watchAll=false --passWithNoTests",
    "build": "expo export --platform web",
    "check-context-patterns": "node scripts/check-context-patterns.js",
    "audit:components": "node scripts/audit-component-reachability.js",
    "audit:components:check": "node scripts/audit-component-reachability.js --check --summary",
    "audit:components:usage": "eslint src app packages/buddy-ui/src --ext .ts,.tsx,.js,.jsx",
    "buddy-ui:build": "pnpm --filter @ravitamil/buddy-ui build",
    "buddy-ui:typecheck": "pnpm --filter @ravitamil/buddy-ui typecheck",
    "buddy-ui:check": "pnpm --filter @ravitamil/buddy-ui lint && pnpm --filter @ravitamil/buddy-ui format:check && pnpm buddy-ui:typecheck && pnpm --filter @ravitamil/buddy-ui test && pnpm buddy-ui:build && pnpm --filter @ravitamil/buddy-ui publint && pnpm --filter @ravitamil/buddy-ui attw && pnpm --filter @ravitamil/buddy-ui pack:dry-run",
    "version:packages": "changeset version",
    "release:packages": "changeset publish",
    "feature-controls:apply": "node scripts/admin/apply-feature-controls.js",
    "feature-controls:validate": "node scripts/admin/apply-feature-controls.js --dry-run supabase/feature-controls.example.json",
    "lint:context": "eslint src --ext .ts,.tsx,.js,.jsx --config .eslintrc.context-migration.js",
    "check-auth": "node scripts/check-auth-config.js",
    "check-android-auth": "node scripts/check-android-auth.js",
    "setup-env": "node scripts/setup-env.js",
    "debug-tamagui": "node scripts/debug-tamagui.js",
    "normalize-fonts": "powershell -ExecutionPolicy Bypass -File scripts/normalize-font-extensions.ps1",
    "postinstall": "patch-package",
    "prepare": "husky",
    "setup-hooks": "powershell -ExecutionPolicy Bypass -File scripts/setup-hooks.ps1",
    "quality-check": "node scripts/quality-check.js",
    "quality:type": "node scripts/quality-check.js type",
    "quality:integration": "node scripts/quality-check.js integration",
    "quality:lint-errors": "node scripts/quality-check.js lint-errors",
    "quality:final": "node scripts/quality-check.js final",
    "pre-deploy": "pnpm quality-check"
  },
  "resolutions": {
    "react-native": "0.86.3",
    "react": "19.2.3",
    "@react-native-async-storage/async-storage": "2.2.0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@ravitamil/buddy-ui": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.95.3",
    "@tamagui/animations-css": "2.7.7",
    "@tamagui/animations-reanimated": "2.7.7",
    "@tamagui/config": "2.7.7",
    "@tamagui/core": "2.7.7",
    "@tamagui/portal": "2.7.7",
    "@tamagui/shorthands": "2.7.7",
    "@tamagui/stacks": "2.7.7",
    "@tamagui/themes": "2.7.7",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.90.22",
    "babel-preset-expo": "~57.0.1",
    "currency-symbol-map": "^5.1.0",
    "dayjs": "^1.11.18",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-auth-session": "~57.0.11",
    "expo-background-task": "~57.0.16",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.17",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-contacts": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-mail-composer": "~57.0.1",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-sms": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.16",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "lottie-react-native": "~7.3.1",
    "patch-package": "^8.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-country-picker-modal": "^2.0.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.63",
    "react-native-keyboard-controller": "^1.21.9",
    "react-native-mmkv-storage": "^12.0.1",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "reanimated-color-picker": "^4.1.1",
    "rn-emoji-keyboard": "^1.7.0",
    "tamagui": "2.7.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@playwright/test": "^1.56.1",
    "@react-native/jest-preset": "^0.85.3",
    "@tamagui/babel-plugin": "2.7.7",
    "@tamagui/cli": "2.7.7",
    "@testing-library/react-native": "^13.3.1",
    "@types/jest": "^29.5.14",
    "@types/json-schema": "^7.0.15",
    "@types/json5": "^0.0.30",
    "@types/react": "~19.2.14",
    "@types/stack-utils": "^2.0.3",
    "@types/tough-cookie": "^4.0.5",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "babel-jest": "^29.7.0",
    "eslint": "^9.33.0",
    "expo-module-scripts": "^4.1.10",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "jest-watch-typeahead": "^2.2.2",
    "lint-staged": "^15.2.2",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@tamagui/core",
          "@tamagui/portal",
          "@tamagui/stacks",
          "currency-symbol-map",
          "react-native-emoji-selector",
          "metro",
          "metro-babel-transformer",
          "metro-cache",
          "metro-cache-key",
          "metro-config",
          "metro-core",
          "metro-file-map",
          "metro-minify-terser",
          "metro-resolver",
          "metro-runtime",
          "metro-source-map",
          "metro-symbolicate",
          "metro-transform-plugins",
          "metro-transform-worker",
          "react-test-renderer",
          "react-native-skottie"
        ]
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "src/**/*.{js,jsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "private": true,
  "packageManager": "pnpm@11.8.0"
}
